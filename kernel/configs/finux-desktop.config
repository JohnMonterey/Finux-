# Help: Finux: desktop and gaming tuning (trades features you may want)
#
# Apply after finux-performance.config:
#
#     make finux-performance.config
#     make finux-desktop.config
#
# Unlike finux-performance.config, every entry here gives something up.
# Read the reason before taking it - one of them is wrong for you if you
# run containers with CPU quotas, a BPF scheduler, or a machine with more
# than one last-level cache.
#
# tools/testing/finux-perf/optimize-config.sh applies this for you and
# checks the ones that depend on your hardware.

# ---------------------------------------------------------------------
# Scheduler features this machine class does not use
# ---------------------------------------------------------------------

# sched_ext adds a task to a global list under a global raw spinlock on
# every fork, and removes it under the same lock on every exit, whether
# or not a BPF scheduler is loaded.
#
# GIVES UP: BPF schedulers - scx_lavd, scx_bpfland, scx_rusty.  Several
# of those target gaming latency specifically, so if you intend to try
# them, leave this on and accept the fork cost.
# CONFIG_SCHED_CLASS_EXT is not set

# Cache-aware load balancing across last-level caches.  On a single-LLC
# machine the balancer never has anywhere to move a task to.
#
# Finux skips the per-mm allocation at runtime when the hardware has one
# LLC, so leaving this enabled is no longer expensive - this entry just
# removes the code entirely.
#
# GIVES UP: nothing on a single-LLC CPU.  Do NOT set this on a multi-CCD
# Ryzen (3900X, 5950X, 7950X, Threadripper), on a multi-socket machine,
# or on a hybrid Intel part.  Check first:
#     cat /sys/devices/system/cpu/cpu*/cache/index3/shared_cpu_list | sort -u
# One line of output means one LLC.
# CONFIG_SCHED_CACHE is not set

# Splits rq->donor and rq->curr into two pointers instead of a union,
# adding 8 bytes to the hottest cacheline in struct rq.
#
# GIVES UP: proxy-execution priority inheritance for mutex owners.
# CONFIG_SCHED_PROXY_EXEC is not set

# cgroup v1 CPU accounting, superseded by cpu.stat under cgroup v2.
#
# GIVES UP: nothing on a unified-cgroup system, which every current
# distribution is.  Only matters if something mounts cgroup v1.
# CONFIG_CGROUP_CPUACCT is not set

# ---------------------------------------------------------------------
# Timer tick
# ---------------------------------------------------------------------

# Keep the tick at 1000 Hz, and be suspicious of advice to lower it.
#
# Both idle governors refuse to stop the tick when the predicted idle
# duration is shorter than one tick period - menu.c:371, teo.c:507.
# Lowering HZ raises that threshold, so a 250 Hz kernel keeps the tick
# running through idle periods that a 1000 Hz kernel would have slept
# through.  Lower HZ is worse for idle power here, not better.
#
# It also matters for the scheduler: sysctl_sched_base_slice is 700 us,
# which a 4 ms tick cannot resolve at all.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set

# ---------------------------------------------------------------------
# Idle and frequency
# ---------------------------------------------------------------------

# Make teo the idle governor by removing the one that outranks it.  teo
# predicts better than menu on current client CPUs, but menu wins the
# default purely on a rating of 20 against 19.
#
# GIVES UP: the menu governor.  If you would rather keep both and choose
# at boot, drop this line and use cpuidle.governor=teo instead.
# CONFIG_CPU_IDLE_GOV_MENU is not set
CONFIG_CPU_IDLE_GOV_TEO=y

# amd-pstate in active mode, which is where EPP applies.  Harmless on
# Intel hardware - the driver simply does not attach.
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3

# ---------------------------------------------------------------------
# Not here on purpose
# ---------------------------------------------------------------------
#
# HRTICK is left at the tree default.  It defaults to true here, and two
# separate reviews of this code reached opposite conclusions about
# whether that is right for a desktop.  Neither had a measurement.
# Settle it yourself and measure frame-time consistency, not throughput:
#     echo NO_HRTICK > /sys/kernel/debug/sched/features
#
# CONFIG_AUDIT is left on.  Turning it off is a real win once auditd has
# run - see A1 in SCHEDULER_PERF_FINDINGS.md - but SELinux troubleshooting
# depends on it and distributions expect it.  Use audit=0 on the kernel
# command line, which is reversible without a rebuild.
#
# -march=native is not set here.  It produces a kernel that boots only on
# the CPU family you built it on, which is fine for a personal build and
# wrong for a fragment other people apply.  Add CONFIG_X86_NATIVE_CPU=y
# yourself, or use optimize-config.sh --native.
#
# Preemption model is untouched.  PREEMPT_LAZY may well beat whatever you
# are running, but nothing in the source audit predicts which way it
# goes, and guessing is what the benchmark harness exists to avoid.
