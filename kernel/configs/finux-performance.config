# Help: Finux: remove runtime overhead that buys nothing on a production kernel
#
# Apply on top of a working configuration:
#
#     make olddefconfig                 # or however you get your .config
#     make finux-performance.config
#
# Everything here is either a debugging facility that costs time on a hot
# path, or a mitigation that does not apply to the CPU you are building
# for.  Nothing in this file removes a feature that a running system
# depends on, and nothing here weakens a mitigation that is active on the
# hardware it protects.  Options that do trade something away live in
# finux-desktop.config instead.
#
# The reasoning behind each entry, with the file:line it was derived from,
# is in SCHEDULER_PERF_FINDINGS.md.

# ---------------------------------------------------------------------
# Debug infrastructure on hot paths
# ---------------------------------------------------------------------

# Turns x86_task_fpu() from an inline pointer addition into an
# out-of-line exported call, reached from the context switch path and
# from every exit to user space.  Defaults to y upstream whenever
# DEBUG_KERNEL is set, which distributions set to expose other options.
# CONFIG_X86_DEBUG_FPU is not set

# Adds a __read_cr3() to every switch_mm_irqs_off(), plus a large number
# of VM_BUG_ON checks throughout the page allocator.
# CONFIG_DEBUG_VM is not set
# CONFIG_DEBUG_VM_PGFLAGS is not set
# CONFIG_DEBUG_VM_RB is not set
# CONFIG_DEBUG_VM_VMACACHE is not set

# preempt_count() validation on every preempt_disable()/enable() pair.
# CONFIG_DEBUG_PREEMPT is not set

# Extra checks in the syscall entry and exit assembly.
# CONFIG_DEBUG_ENTRY is not set

# Lock validation.  held_locks[48] alone is roughly 2.3 KB inside every
# task_struct, before counting the work done on each acquire and release.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_PROVE_RAW_LOCK_NESTING is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_LOCK_STAT is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set

# Selects PROVE_LOCKING, so leaving it on silently defeats the above.
# CONFIG_DEBUG_NET_SMALL_RTNL is not set

# latency_record[32] is roughly 3.8 KB inside every task_struct, and
# LATENCYTOP selects SCHEDSTATS, so leaving it on also defeats any
# attempt to turn scheduler statistics off.
# CONFIG_LATENCYTOP is not set

# Sanitisers and coverage.  All of these are development tools.
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_KCOV is not set
# CONFIG_UBSAN is not set
# CONFIG_KMSAN is not set

# Allocator and list debugging.
# CONFIG_DEBUG_OBJECTS is not set
# CONFIG_DEBUG_KMEMLEAK is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_PLIST is not set
# CONFIG_DEBUG_SG is not set
# CONFIG_DEBUG_NOTIFIERS is not set
# CONFIG_SLUB_DEBUG_ON is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_FAULT_INJECTION is not set

# Runs the whole ftrace self-test suite at every boot.
# CONFIG_FTRACE_STARTUP_TEST is not set

# ---------------------------------------------------------------------
# Mitigations that do not apply to this hardware
# ---------------------------------------------------------------------

# Mitigates an Intel Skylake RSB underflow.  The mitigation itself is
# opt-in at boot via retbleed=stuff, but the ~5% of function-entry
# padding it compiles in is paid unconditionally, on every function in
# the kernel, whether or not the mitigation is ever armed.  It does
# nothing on AMD in any configuration.
#
# Passing retbleed=stuff without this option warns and falls back to
# another retbleed mitigation, so the machine is not left unprotected.
# Turn it back on if you run a Skylake-generation Intel CPU and intend
# to use retbleed=stuff.
# CONFIG_MITIGATION_CALL_DEPTH_TRACKING is not set

# ---------------------------------------------------------------------
# Make a better idle governor available
# ---------------------------------------------------------------------

# Build teo in.  This changes nothing on its own - menu outranks it 20 to
# 19 and still wins the default - but it lets you try the other governor
# with cpuidle.governor=teo or through sysfs.  finux-desktop.config makes
# it the default outright.
CONFIG_CPU_IDLE_GOV_TEO=y

# ---------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------
#
# CONFIG_DEBUG_FS stays on.  There is no CONFIG_SCHED_DEBUG any more - the
# scheduler's debugfs interface is unconditional now - so DEBUG_FS is the
# only thing standing between you and /sys/kernel/debug/sched/, which is
# where scheduler features are tuned and where half the measurements in
# SCHEDULER_PERF_FINDINGS.md have to be taken.  Turning it off removes the
# ability to test any of this.
#
# CONFIG_CFS_BANDWIDTH stays on.  It is static-key gated and genuinely
# free until a cgroup sets a quota; removing it breaks systemd slices
# that do.
#
# CONFIG_PSI stays on.  systemd-oomd reads it.  See SCHEDULER_PERF_FINDINGS.md
# if you want to disable it anyway.
#
# CONFIG_KFENCE stays on.  Its sampling interval makes it close to free
# and it catches real memory-safety bugs.
#
# No mitigation that is active on the hardware you are building for is
# touched, and neither are IA32_EMULATION, SCHED_SMT, CGROUPS,
# PERF_EVENTS, SECCOMP, BPF_SYSCALL or module signing.
